PRODUCT_NAME = Beamer Projector
PRODUCT_MODULE_NAME = BeamerProjector
EXECUTABLE_NAME = BeamerProjector
PRODUCT_BUNDLE_IDENTIFIER = org.beamerprojector.macos
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Sources/BeamerProjector/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SWIFT_OBJC_BRIDGING_HEADER = Sources/NativePDF/NativePDF.h
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/.build/vendor/qpdf/include" "$(BEAMER_DEPS_DIR)/qpdf/libqpdf"
LIBRARY_SEARCH_PATHS = $(inherited) "$(BEAMER_DEPS_DIR)/qpdf/libqpdf" "$(BEAMER_DEPS_DIR)/jpeg/lib"
OTHER_LDFLAGS = $(inherited) -lqpdf -ljpeg -lz -lc++
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
