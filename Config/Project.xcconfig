SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 5.0
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

BEAMER_DEPS_DIR = $(SRCROOT)/.build/XcodeDependencies
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(BEAMER_DEPS_DIR)/Frameworks"
